# Copy to .env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------------
PORT=3000
# Public URL of this site, no trailing slash. Used for OAuth redirects and links.
BASE_URL=http://localhost:3000
# Optional: where the app is reachable when it is mounted under a subpath
# (for example /valorant-shop behind a reverse proxy), and the public home that
# *.vercel.app hits are redirected to.
APP_URL=
BASE_PATH=
CANONICAL_HOME=
# Set to false to run only the Discord bot endpoints and no website.
WEBSITE_ENABLED=true

# --- Secrets (the app refuses to boot without SESSION_SECRET and LINK_SECRET) --
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
LINK_SECRET=
# 64 hex characters (32 bytes). Encrypts stored Riot tokens. Changing it makes
# every stored account undecryptable, so every user has to re-link.
ENCRYPTION_KEY=
# Protects /api/cron/*. Falls back to LINK_SECRET. SCHEDULER_SECRET is for an
# external exact-time scheduler (header x-scheduler-secret or ?key=).
CRON_SECRET=
SCHEDULER_SECRET=

# --- Storage (Supabase). Without these the app keeps everything in memory. ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Discord ------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Linked Discord user whose Riot account supplies /bundle data for everyone.
BUNDLE_SOURCE_ID=
# Optional: admin to ping on failures, and the private channel for log lines.
ADMIN_DISCORD_ID=
LOG_CHANNEL_ID=
# Optional: only for scripts/register-commands.js <guildId> (dev servers).
DISCORD_GUILD_ID=
# Optional: custom emoji markup for the /collection Riot Gunbuddy footer, e.g. <:riotgunbuddy:ID>.
EMOJI_RIOT_GUNBUDDY=
# Optional: channel used by the scripts/test-*.js helpers.
TEST_CHANNEL_ID=

# --- Riot (all optional) ---------------------------------------------------------
# Only needed if you have an approved Riot OAuth application.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
# Development key (RGAPI-..., expires every 24h), used only to show a Riot ID.
RIOT_DEV_API_KEY=

# --- Debug --------------------------------------------------------------------
DETAIL_DEBUG=
