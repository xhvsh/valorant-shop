{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/dailyshop",
      "schedule": "0 0 * * *"
    }
  ]
}
